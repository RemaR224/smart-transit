<mxfile host="app.diagrams.net">
  <diagram name="Smart Transit Architecture" id="arch">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- AWS cloud container -->
        <mxCell id="aws" value="AWS Cloud (us-east-1)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7fbfb;strokeColor=#8fa3a8;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Times New Roman;fontSize=15;fontStyle=1;fontColor=#56636a;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="820" height="470" as="geometry" />
        </mxCell>

        <!-- Main pipeline (after / scaled system) -->
        <mxCell id="sim" value="&lt;b&gt;Vehicle simulator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#56636a&quot;&gt;Node.js, 4 corridors&lt;br&gt;buses + V/Line trains&lt;br&gt;GPS, speed, occupancy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f6;strokeColor=#1a9e96;strokeWidth=2;fontFamily=Times New Roman;fontSize=14;fontColor=#1f2a2e;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="iot" value="&lt;b&gt;AWS IoT Core&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#56636a&quot;&gt;MQTT broker, TLS 8883&lt;br&gt;X.509 certificate&lt;br&gt;least-privilege policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f6;strokeColor=#1a9e96;strokeWidth=2;fontFamily=Times New Roman;fontSize=14;fontColor=#1f2a2e;" vertex="1" parent="1">
          <mxGeometry x="230" y="140" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="&lt;b&gt;IoT Rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#56636a&quot;&gt;transit_to_lambda&lt;br&gt;SELECT * FROM&lt;br&gt;transit/+/vehicle/+/telemetry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f6;strokeColor=#1a9e96;strokeWidth=2;fontFamily=Times New Roman;fontSize=14;fontColor=#1f2a2e;" vertex="1" parent="1">
          <mxGeometry x="420" y="140" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#56636a&quot;&gt;transit-processor&lt;br&gt;delay + crowd logic&lt;br&gt;scales out automatically&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6efec;strokeColor=#0e5f5a;strokeWidth=2;fontFamily=Times New Roman;fontSize=14;fontColor=#1f2a2e;" vertex="1" parent="1">
          <mxGeometry x="610" y="140" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ddb" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#56636a&quot;&gt;TransitVehicleState (live)&lt;br&gt;TransitTelemetry (history)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#eef7f6;strokeColor=#1a9e96;strokeWidth=2;fontFamily=Times New Roman;fontSize=14;fontColor=#1f2a2e;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dash" value="&lt;b&gt;Operator dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#56636a&quot;&gt;map, KPIs, alerts,&lt;br&gt;route + vehicle tables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f6;strokeColor=#1a9e96;strokeWidth=2;fontFamily=Times New Roman;fontSize=14;fontColor=#1f2a2e;" vertex="1" parent="1">
          <mxGeometry x="1060" y="140" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cw" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#56636a&quot;&gt;concurrency, duration,&lt;br&gt;throttles, logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8fa3a8;strokeWidth=2;fontFamily=Times New Roman;fontSize=14;fontColor=#1f2a2e;" vertex="1" parent="1">
          <mxGeometry x="610" y="290" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- Baseline (before) -->
        <mxCell id="base" value="&lt;b&gt;Baseline EC2 server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#56636a&quot;&gt;one MQTT subscriber&lt;br&gt;one message at a time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbefec;strokeColor=#c8553d;strokeWidth=2;dashed=1;fontFamily=Times New Roman;fontSize=14;fontColor=#1f2a2e;" vertex="1" parent="1">
          <mxGeometry x="420" y="410" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- Edges: main path -->
        <mxCell id="e1" value="MQTT / TLS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0e5f5a;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#56636a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sim" target="iot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="every message" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0e5f5a;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#56636a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="iot" target="rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="invoke" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0e5f5a;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#56636a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rule" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="write" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0e5f5a;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#56636a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lambda" target="ddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="read" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0e5f5a;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#56636a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ddb" target="dash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alerts: routed above the row so nothing crosses -->
        <mxCell id="e6" value="alerts: transit/alerts/&amp;lt;route&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0e5f5a;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Times New Roman;fontSize=11;fontColor=#56636a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lambda" target="dash">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="685" y="100" />
              <mxPoint x="1140" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Monitoring -->
        <mxCell id="e7" value="metrics + logs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#8fa3a8;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#56636a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lambda" target="cw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Baseline path (before test only), routed along the bottom -->
        <mxCell id="e8" value="before test only&lt;br&gt;(IoT Rule switched off)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#c8553d;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Times New Roman;fontSize=11;fontColor=#c8553d;labelBackgroundColor=#f7fbfb;" edge="1" parent="1" source="iot" target="base">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="305" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="write (same tables)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#c8553d;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Times New Roman;fontSize=11;fontColor=#c8553d;labelBackgroundColor=#f7fbfb;" edge="1" parent="1" source="base" target="ddb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="890" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0e5f5a&quot;&gt;&amp;#9644;&amp;#9644;&lt;/font&gt; scaled system (after)&lt;br&gt;&lt;font color=&quot;#c8553d&quot;&gt;- - -&lt;/font&gt; single-server baseline (before)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=12;fontColor=#1f2a2e;strokeColor=#cfe5e2;fillColor=#ffffff;rounded=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="400" width="200" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
